-- Write your PostgreSQL query statement below
WITH ranked AS(
    SELECT 
        *,
        DENSE_RANK() OVER(PARTITION BY departmentid ORDER BY salary DESC) as dense_rnk
        FROM employee
) 
SELECT d.name AS Department, r.name AS Employee, r.salary AS Salary
FROM ranked r
JOIN Department d 
ON r.departmentId=d.id
WHERE dense_rnk <=3;
